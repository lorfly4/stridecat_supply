<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout Page</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body class="bg-gray-100 p-6">
  <div class="container max-w-3xl mx-auto bg-white p-6 rounded-xl shadow-md">
    <h2 class="text-2xl font-bold mb-6">Checkout</h2>

    <div class="mb-6">
      <h3 class="text-lg font-semibold mb-2">Produk</h3>
      <% if (produkList && produkList.length > 0) { %>
        <% let total = 0; %>
        <% produkList.forEach(function(produk) { total += produk.harga; %>
          <div class="flex gap-4 border-b pb-4 mb-4">
            <img src="<%= produk.foto %>" alt="<%= produk.nama_produk %>" class="w-20 rounded-md">
            <div>
              <p class="font-medium text-lg"><%= produk.nama_produk %></p>
              <p class="text-gray-600">Harga: Rp<%= produk.harga.toLocaleString('id-ID') %></p>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>Tidak ada produk yang dipilih.</p>
      <% } %>
    </div>

    <form action="/bayar" method="post">
      <div class="mb-6">
        <label for="payment" class="block font-semibold mb-1">Metode Pembayaran</label>
        <select id="payment" name="metode_pembayaran" class="w-full p-2 border rounded">
          <option>Transfer Bank</option>
          <option>GoPay</option>
          <option>ShopeePay</option>
          <option>COD (Bayar di Tempat)</option>
        </select>
      </div>

      <div class="bg-blue-100 p-4 rounded mb-4">
        <p class="font-semibold text-blue-800">Total Bayar:</p>
        <p class="text-lg text-blue-800">Rp<%= total.toLocaleString('id-ID') %></p>
      </div>

      <% if (produkList && produkList.length > 0) { %>
        <% produkList.forEach(function(produk) { %>
          <input type="hidden" name="id_produk[]" value="<%= produk.id_produk %>">
          <input type="hidden" name="harga[]" value="<%= produk.harga %>">
        <% }) %>
        <input type="hidden" name="total" value="<%= total %>">
        <input type="hidden" name="id_user" value="<%= typeof userId !== 'undefined' ? userId : '' %>">
        <input type="hidden" name="tanggal" value="<%= new Date().toISOString().split('T')[0] %>">
        <input type="hidden" name="status" value="belum bayar">
        <input type="hidden" name="alamat" value="-">
        <input type="hidden" name="resi" value="-">
        <input type="hidden" name="jasa_pengiriman" value="-">

        <button class="btn-checkout bg-blue-600 text-white px-4 py-2 rounded w-full hover:bg-blue-700" type="submit">Bayar Sekarang</button>
      <% } else { %>
        <button class="btn-checkout bg-gray-400 text-white px-4 py-2 rounded w-full" disabled>Tidak ada produk</button>
      <% } %>
    </form>
  </div>
</body>
</html>
