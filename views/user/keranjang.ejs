<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Keranjang - Stridecat Supply</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
</head>
<body class="bg-[#f5f5f7] font-sans text-[13px] text-[#222222]">

<header class="border-b border-gray-200">
  <div class="container mx-auto px-4 flex items-center justify-between py-4">
    <a class="flex items-center space-x-2" href="/landing">
      <img src="/img/logo.png" alt="Logo" class="h-12" />
    </a>
    <nav class="hidden md:flex space-x-8 font-semibold text-gray-700">
      <a href="/landing" class="hover:text-red-600 transition">Home</a>
      <a href="/landing#products" class="hover:text-red-600 transition">Products</a>
    </nav>
    <div class="flex items-center space-x-4">
      <a href="/keranjang" class="relative text-gray-700 hover:text-red-600">
        <i class="fas fa-shopping-cart text-lg"></i>
        <span class="absolute -top-2 -right-2 bg-red-600 text-white rounded-full text-xs w-5 h-5 flex items-center justify-center">
          <%= keranjangList.length %>
        </span>
      </a>
      <div class="relative">
        <button onclick="toggleMenu()" class="flex items-center text-gray-700 hover:text-red-600 space-x-1">
          <i class="fas fa-user text-lg"></i>
          <span><%= users.name %></span>
          <i class="fas fa-caret-down ml-1"></i>
        </button>
        <div id="accountMenu" class="absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded shadow-lg hidden z-50">
          <a href="/logout" class="block px-4 py-2 text-gray-700 hover:bg-red-50 hover:text-red-600">Logout</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 mt-6">

  <% for (const produk of keranjangList) { %>
  <div class="bg-white rounded-sm p-4 mb-3 border flex items-center gap-4">
    <form action="/keranjang/hapus/<%= produk.id_keranjang %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus produk ini?')">
      <button type="submit" class="text-red-600 hover:underline text-sm mr-4">🗑️</button>
    </form>

    <input type="checkbox" name="produk_id" value="<%= produk.id_produk %>"
           class="item-checkbox w-4 h-4"
           data-harga="<%= produk.harga %>" data-jumlah="<%= produk.jumlah %>" />

    <img src="<%= produk.foto %>" alt="<%= produk.nama_produk %>" class="w-20 h-20 object-contain" />

    <div class="flex-1 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
      <div>
        <p class="font-semibold"><%= produk.nama_produk %></p>
        <p class="text-gray-600">Rp<%= produk.harga.toLocaleString("id-ID") %></p>
        <p class="text-gray-500">Jumlah: <%= produk.jumlah %></p>
      </div>
    </div>
  </div>
<% } %>

  <!-- Form checkout hanya di bagian bawah -->
  <form id="checkoutForm" action="/checkout" method="get">
    <div class="bg-white px-4 py-3 flex flex-wrap items-center gap-2 border-t">
      <input type="checkbox" id="selectAll" class="w-4 h-4">
      <label for="selectAll" class="mr-auto text-sm">Pilih Semua (<span id="jumlahProduk">0</span>)</label>

      <div class="text-sm text-gray-600">Total (<span id="totalProduk">0</span> produk):</div>
      <div class="text-[#3498db] font-semibold text-[18px]" id="totalHarga">Rp0</div>

      <button type="submit" class="bg-[#3498db] text-white px-6 py-2 rounded text-sm font-semibold">
        Checkout
      </button>
    </div>
  </form>

</main>

<script>
  function toggleMenu() {
    const menu = document.getElementById('accountMenu');
    menu.classList.toggle('hidden');
  }

  document.addEventListener('click', function(e) {
    const btn = document.querySelector('[onclick="toggleMenu()"]');
    const menu = document.getElementById('accountMenu');
    if (!btn.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.add('hidden');
    }
  });

  function calculateTotal() {
    const checkboxes = document.querySelectorAll('.item-checkbox:checked');
    let jumlah = 0;
    let total = 0;
    checkboxes.forEach(cb => {
      const harga = parseInt(cb.getAttribute('data-harga')) || 0;
      const qty = parseInt(cb.getAttribute('data-jumlah')) || 1;
      jumlah += qty;
      total += harga * qty;
    });
    document.getElementById('jumlahProduk').textContent = jumlah;
    document.getElementById('totalProduk').textContent = jumlah;
    document.getElementById('totalHarga').textContent = `Rp${total.toLocaleString('id-ID')}`;
  }

  document.querySelectorAll('.item-checkbox').forEach(cb => {
    cb.addEventListener('change', calculateTotal);
  });

  document.getElementById('selectAll').addEventListener('change', function() {
    const check = this.checked;
    document.querySelectorAll('.item-checkbox').forEach(cb => {
      cb.checked = check;
    });
    calculateTotal();
  });

  document.getElementById('checkoutForm').addEventListener('submit', function(e) {
  const checked = document.querySelectorAll('.item-checkbox:checked');
  if (checked.length === 0) {
    e.preventDefault();
    alert('Pilih minimal satu produk untuk checkout!');
    return;
  }

  let total = 0;
  checked.forEach(cb => {
    const harga = parseInt(cb.getAttribute('data-harga')) || 0;
    const qty = parseInt(cb.getAttribute('data-jumlah')) || 1;
    total += harga * qty;

    // ✅ Tambahkan input tersembunyi untuk setiap id_produk yang dicentang
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'produk_id[]';
    input.value = cb.value;
    e.target.appendChild(input);
  });

  const totalInput = document.createElement('input');
  totalInput.type = 'hidden';
  totalInput.name = 'total';
  totalInput.value = total;
  this.appendChild(totalInput);
});


  calculateTotal();
</script>
</body>
</html>
