  <!DOCTYPE html>
  <html lang="id">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Invoice Checkout</title>
      <script src="https://cdn.tailwindcss.com"></script>
    </head>
    <body class="bg-gray-100 p-6">
      <div class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow-lg">
        <div class="text-center mb-6">
          <h1 class="text-2xl font-bold text-gray-800">INVOICE</h1>
          <p class="text-sm text-gray-500">Terima kasih atas pesanan Anda</p>
          <% if (invoice) { %>
            <div class="text-xs text-gray-400">No. Invoice: <%= invoice %></div>
          <% } %>
        </div>

        <div class="mb-4">
          <h2 class="text-gray-700 font-semibold mb-2">Barang yang Dibeli:</h2>
          <ul class="text-gray-600 list-disc pl-5 space-y-1">
            <% if (produkList && produkList.length > 0) { %>
              <% produkList.forEach(function(produk) { %>
                <li><%= produk.nama_produk %> - Rp <%= produk.harga.toLocaleString('id-ID') %></li>
              <% }) %>
            <% } else { %>
              <li>Tidak ada produk.</li>
            <% } %>
          </ul>
        </div>

        <div class="mb-4">
          <h2 class="text-gray-700 font-semibold">Total Harga:</h2>
          <p class="text-lg font-bold text-green-600">Rp <%= totalBayar.toLocaleString('id-ID') %></p>
        </div>

        <div class="mb-4">
          <h2 class="text-gray-700 font-semibold">Silakan Transfer ke:</h2>
          <div class="bg-gray-100 p-4 rounded-lg text-sm text-gray-700">
            <p><strong>Bank:</strong> BCA</p>
            <p><strong>Nomor Rekening:</strong> 1234567890</p>
            <p><strong>Atas Nama:</strong> PT Contoh Store</p>
          </div>
        </div>

        <div class="text-sm text-gray-500 mt-6 border-t pt-4 text-center">
          <p>Invoice ini sah tanpa tanda tangan.</p>
        </div>
      </div>
    </body>
  </html>