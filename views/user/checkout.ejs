<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">
  <div class="container max-w-3xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md">
    <h2 class="text-2xl font-bold mb-6">Checkout</h2>

    <form action="/bayar" method="POST">
      <% if (produkList.length> 0) { %>
        <% let total=0; %>
          <% produkList.forEach(function(produk) { const subtotal=produk.harga * produk.jumlah; total +=subtotal; %>
            <div class="flex gap-4 border-b pb-4 mb-4">
              <img src="<%= produk.foto %>" alt="<%= produk.nama_produk %>" class="w-20 rounded-md">
              <div>
                <p class="font-medium text-lg">
                  <%= produk.nama_produk %>
                </p>
                <p class="text-gray-600">Harga: Rp<%= produk.harga.toLocaleString('id-ID') %>
                </p>
                <p class="text-gray-600">Jumlah: <%= produk.jumlah %>
                </p>
                <p class="text-gray-800 font-semibold">Subtotal: Rp<%= subtotal.toLocaleString('id-ID') %>
                </p>
              </div>
            </div>

            <input type="hidden" name="id_produk[]" value="<%= produk.id_produk %>">
            <input type="hidden" name="harga[]" value="<%= subtotal %>">
            <input type="hidden" name="jumlah[]" value="<%= produk.jumlah %>">
            <% }) %>

              <div class="mb-6">
                <label for="metode_pembayaran" class="block mb-2 text-sm font-medium text-gray-700">Metode
                  Pembayaran</label>
                <select name="metode_pembayaran" id="metode_pembayaran"
                  class="w-full border border-gray-300 rounded px-3 py-2">
                  <option value="Transfer Bank">Transfer Bank</option>
                </select>

              </div>

              <div class="mb-6">
                <label for="alamat" class="block mb-2 text-sm font-medium text-gray-700">Alamat Pengiriman</label>
                <textarea name="alamat" id="alamat" class="w-full border border-gray-300 rounded px-3 py-2"
                  required></textarea>
              </div>

              <input type="hidden" name="tanggal" value="<%= new Date().toISOString().split('T')[0] %>">
              <input type="hidden" name="status" value="menunggu pembayaran">
              <input type="hidden" name="resi" value="-">
              <input type="hidden" name="jasa_pengiriman" value="JNE">

              <div class="mb-6 text-right">
                <p class="text-xl font-semibold">Total: Rp<%= total.toLocaleString('id-ID') %>
                </p>
              </div>

              <button type="submit"
                class="w-full bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition duration-200">
                Bayar Sekarang
              </button>
              <% } else { %>
                <p>Tidak ada produk yang dipilih.</p>
                <% } %>
    </form>
  </div>
</body>

</html>