<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Edit History Pembelian</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css" />
    <!-- AdminLTE -->
    <link rel="stylesheet" href="/dist/css/adminlte.min.css" />
  </head>
  <body class="hold-transition sidebar-mini">
    <div class="wrapper">
      <!-- Navbar -->
      <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button">
              <i class="fas fa-bars"></i>
            </a>
          </li>
        </ul>
        <ul class="navbar-nav ml-auto">
          <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
              <i class="far fa-user"></i>
              <span><%= users.name ? users.name : 'Guest' %></span>
            </a>
            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
              <a href="/profil" class="dropdown-item">
                <i class="fas fa-user mr-2"></i> Profil
              </a>
              <div class="dropdown-divider"></div>
              <a href="/logout" class="dropdown-item">
                <i class="fas fa-sign-out-alt mr-2"></i> Logout
              </a>
            </div>
          </li>
        </ul>
      </nav>
      <!-- /.navbar -->

      <!-- Main Sidebar Container -->
      <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="/landing" class="brand-link">
          <span class="brand-text font-weight-light">Stridecat Supply</span>
        </a>
        <div class="sidebar">
          <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
              <img
                src="<%= users.foto ? users.foto : '/img/avatar.png' %>"
                class="img-circle elevation-2"
                alt="User Image"
              />
            </div>
            <div class="info">
              <a href="#" class="d-block">
                <%= users.name ? users.name : 'Guest' %>
              </a>
            </div>
          </div>
          <nav class="mt-2">
            <ul
              class="nav nav-pills nav-sidebar flex-column"
              data-widget="treeview"
              role="menu"
            >
              <li class="nav-item">
                <a href="/admin/landing" class="nav-link">
                  <i class="nav-icon fas fa-home"></i>
                  <p>Home</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/profil" class="nav-link">
                  <i class="nav-icon fas fa-user"></i>
                  <p>Profil</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/produk" class="nav-link">
                  <i class="nav-icon fas fa-book"></i>
                  <p>Produk</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/admin/history" class="nav-link active">
                  <i class="nav-icon fas fa-history"></i>
                  <p>History Pembelian</p>
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>

      <!-- Content Wrapper. Contains page content -->
      <div class="content-wrapper">
        <div class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1 class="m-0">Edit History Pembelian</h1>
              </div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item"><a href="/admin/landing">Home</a></li>
                  <li class="breadcrumb-item"><a href="/admin/history">History</a></li>
                  <li class="breadcrumb-item active">Edit</li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <section class="content">
          <div class="container-fluid">
            <div class="row">
              <div class="col-md-8">
                <div class="card card-primary">
                  <div class="card-header">
                    <h3 class="card-title">Edit Data History</h3>
                  </div>
                  <form action="/admin/history/<%= history.id %>/edit" method="post">
                    <div class="card-body">
                      <div class="form-group">
                        <label for="status">Status</label>
                        <select class="form-control" name="status" id="status" required>
                          <option value="belum bayar" <%= history.status === 'belum bayar' ? 'selected' : '' %>>
                            Belum Bayar
                          </option>
                          <option value="sudah di bayar" <%= history.status === 'sudah di bayar' ? 'selected' : '' %>>
                            Sudah di Bayar
                          </option>
                          <option value="sedang dikemas" <%= history.status === 'sedang dikemas' ? 'selected' : '' %>>
                            Sedang di Kemas
                          </option>
                          <option value="dikirim" <%= history.status === 'dikirim' ? 'selected' : '' %>>
                            Dikirim
                          </option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="resi">Resi</label>
                        <input
                          type="text"
                          class="form-control"
                          name="resi"
                          id="resi"
                          value="<%= history.resi || '' %>"
                          placeholder="Masukkan nomor resi"
                        />
                      </div>
                      <div class="form-group">
                        <label for="jasa_pengiriman">Jasa Pengiriman</label>
                        <input
                          type="text"
                          class="form-control"
                          name="jasa_pengiriman"
                          id="jasa_pengiriman"
                          value="<%= history.jasa_pengiriman || '' %>"
                          placeholder="Masukkan jasa pengiriman"
                        />
                      </div>
                    </div>
                    <div class="card-footer">
                      <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Simpan
                      </button>
                      <!-- FIXED: Changed href from "edit_history.ejs" to proper route -->
                      <a href="/admin/history" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Batal
                      </a>
                    </div>
                  </form>
                </div>
              </div>
              
              <!-- Optional: Add info card -->
              <div class="col-md-4">
                <div class="card card-info">
                  <div class="card-header">
                    <h3 class="card-title">Informasi</h3>
                  </div>
                  <div class="card-body">
                    <p><strong>ID History:</strong> <%= history.id %></p>
                    <p><strong>Status Saat Ini:</strong> 
                      <span class="badge badge-<%= 
                        history.status === 'belum bayar' ? 'danger' : 
                        history.status === 'sudah di bayar' ? 'warning' : 
                        history.status === 'sedang dikemas' ? 'info' : 
                        'success' 
                      %>">
                        <%= history.status %>
                      </span>
                    </p>
                    <hr>
                    <small class="text-muted">
                      Pastikan untuk mengisi nomor resi dan jasa pengiriman ketika status sudah "Dikirim"
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      <!-- /.content-wrapper -->
    </div>

    <!-- jQuery -->
    <script src="/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="/dist/js/adminlte.min.js"></script>
  </body>
</html>